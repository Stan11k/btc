# Скопіюйте цей файл у .env і заповніть своїми значеннями.
# НІКОЛИ не комітьте .env у git і не вставляйте його вміст у чат.

# ---- Головний вимикач ----
# false (за замовчуванням) = paper/dry-run: бот тільки логує, що б він зробив,
# реальних ордерів НЕ виставляє. Поставте true, лише коли повністю довіряєте
# налаштуванням і обидва адаптери нижче реально підключені (implemented: true
# в src/adapters/*.js).
LIVE_TRADING=false

# ---- Торгові параметри ----
SYMBOL=BTC-PERP
MIN_SPREAD_PCT=0.25        # поріг входу в угоду, % (з запасом понад комісії)
CLOSE_SPREAD_PCT=0.05      # закрити позицію, коли спред стиснувся до цього рівня
POSITION_SIZE_USD=100      # розмір однієї ноги угоди в доларах
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_USD=50      # аварійний стоп: бот зупиняється, якщо денний збиток перевищив цю суму
POLL_MS=1000

# ---- Nado (docs.nado.xyz) ----
# Ордери підписуються гаманцем (EIP-712) — потрібен приватний ключ ОКРЕМОГО
# гаманця, створеного спеціально для цього бота, профінансованого лише
# сумою, якою готові ризикувати. НІКОЛИ не основний гаманець.
NADO_WALLET_PRIVATE_KEY=
NADO_BASE_URL=https://gateway.prod.nado.xyz/v1

# ---- RISEx ----
# rise.trade → Settings → API Wallets: там генерується окремий "API-гаманець",
# який може підписувати угоди, але не може вивести кошти. Приватний ключ саме
# ЦЬОГО гаманця (можна той самий, що й NADO_WALLET_PRIVATE_KEY, якщо
# спеціально створили один гаманець для обох майданчиків) — сюди:
RISEX_WALLET_PRIVATE_KEY=
RISEX_BASE_URL=https://api.rise.trade
# Дата закінчення дії цього API-гаманця (дивіться колонку "Expires" на
# сторінці API Wallets), формат РРРР-ММ-ДД. Бот попередить заздалегідь і
# примусово зупинить торгівлю після цієї дати, щоб не ловити помилки
# авторизації посеред роботи — не забудьте оновити тут після продовження
# терміну дії на сайті.
RISEX_API_WALLET_EXPIRES=2026-10-07

# ---- Сповіщення (опційно) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
